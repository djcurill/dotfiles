root = true

# All files
[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

# bash
[*.sh]
indent_style = tab
indent_size = 2

# Go
[*.go]
indent_style = tab
indent_size = 4

# Go module files
[go.mod]
indent_style = tab
indent_size = 4

# Python
[*.py]
indent_style = space
indent_size = 4
max_line_length = 88

[*.html]
indent_stype = space
indent_size = 4
